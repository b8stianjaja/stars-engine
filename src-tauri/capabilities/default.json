{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capacidades de lectura y escritura para STARS ENGINE",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "fs:allow-read",
    "fs:allow-write",
    "fs:allow-exists",
    "dialog:allow-open",
    "dialog:allow-save",
    {
      "identifier": "fs:scope-appdata",
      "allow": [
        {
          "path": "$APPDATA/**"
        }
      ]
    }
  ]
}